{
  "name": "yoiniwa",
  "version": "0.2.1",
  "description": "Yoiniwa (宵庭), a quiet offline reference board for Windows",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:tests",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc --all-targets",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "build:thumbnail-provider": "node scripts/build-thumbnail-provider.mjs",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "lint": "eslint src scripts --max-warnings=0",
    "check:dead-code": "knip",
    "check": "npm run typecheck && npm run lint && npm run check:dead-code && npm test",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run build:web && npm run check:rust",
    "dist": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "immer": "^11.1.15",
    "knip": "^6.29.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  }
}
